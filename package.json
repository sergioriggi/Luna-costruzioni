{
  "name": "luna-costruzioni",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/genera-sitemap.mjs",
    "preview": "vite preview",
    "lint": "oxlint",
    "brand": "node scripts/build-brand-assets.mjs",
    "media": "node scripts/prepare-media.mjs",
    "assets": "npm run brand && npm run media && npm run fonts",
    "fonts": "node scripts/scarica-font.mjs",
    "verifica": "node scripts/verifica-conformita.mjs",
    "media:manifest": "node scripts/prepare-media.mjs --manifest"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.2"
  },
  "description": "Sito web di Luna Costruzioni srl — Concessionario Autorizzato Piscine Rocks Design per la Sicilia."
}
