# ═══════════════════════════════════════════════════════════════════════════
#  Variabili di compilazione della PRODUZIONE, versionate di proposito.
#
#  Vite legge questo file quando compila in modalità produzione e incolla i
#  valori dentro il bundle del browser. Qui può stare solo ciò che è pubblico
#  per sua natura: mai una password, mai una credenziale SMTP.
# ═══════════════════════════════════════════════════════════════════════════

# Chiave del modulo su Web3Forms, il servizio che consegna le richieste a
# info@lunacostruzioni.it senza bisogno di un server nostro.
#
# Sta qui e non nel pannello dell'hosting perché è **pubblica per progetto**:
# finisce comunque nel codice che arriva al browser — la loro documentazione
# raccomanda proprio l'uso lato client — quindi tenerla in un pannello non la
# nasconderebbe a nessuno, e in compenso il sito smetterebbe di funzionare a
# ogni reinstallazione dell'hosting. Versionata, invece, si rilegge, si
# ritrova e la CI compila esattamente ciò che va online.
#
# Che cosa può farci chi la legge: inviare messaggi alla casella di Luciano.
# Nient'altro: la destinazione è fissata nel loro pannello, non qui. Web3Forms
# blocca le chiamate che non arrivano da un browser (provato: «Use our API in
# client side»), quindi la via d'abuso più comoda è già chiusa. Se un giorno
# arrivasse spam vero, si rigenera la chiave e si aggiunge Turnstile.
VITE_WEB3FORMS_KEY=fef89e94-edf8-4f42-bac3-d81529fd99f0

# Identificatore Google Ads. Pubblico come il precedente: sta nel codice del
# browser per forza di cose, ed è un identificatore di account pubblicitario,
# non una credenziale. Il tag si carica **solo dopo il consenso** nel banner
# cookie, mai al primo caricamento della pagina.
VITE_GOOGLE_ADS_ID=AW-18447146211

# Etichetta dell'azione di conversione, formato `AW-XXXXXXXXXX/Etichetta`.
# Si copia dal pannello Ads quando si crea l'azione di conversione. Finché
# questa riga è vuota il sito costruisce i pubblici per il remarketing ma
# **non conta i contatti**: la campagna può partire, l'ottimizzazione sulle
# conversioni no.
VITE_GOOGLE_ADS_CONVERSIONE=

# ───────────────────────────────────────────────────────────────────────────
#  VITE_SITE_URL NON va messa qui, ed è una trappola già verificata.
#
#  Vite legge questo file solo per il bundle del browser. Gli script che
#  generano `robots.txt` e la sitemap girano in Node e leggono le variabili
#  vere del sistema: con l'indirizzo dichiarato solo qui, le pagine
#  uscirebbero indicizzabili mentre `robots.txt` continuerebbe a dire
#  `Disallow: /`. Sito online e invisibile, senza che niente sembri rotto.
#
#  Sta quindi fra le variabili d'ambiente del pannello Hostinger, dove la
#  vedono sia il compilatore sia gli script. Se un giorno la si volesse
#  spostare qui, prima vanno fatti caricare questo file anche a
#  `scripts/prerender.mjs`, `genera-sitemap.mjs` e `verifica-conformita.mjs`
#  con `process.loadEnvFile?.()`.
# ───────────────────────────────────────────────────────────────────────────
