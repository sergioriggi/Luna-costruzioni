# ═══════════════════════════════════════════════════════════════════════════
#  DI COMPILAZIONE — finiscono dentro il bundle del browser.
#
#  Vite incolla nel codice tutto ciò che ha il prefisso VITE_, al momento della
#  compilazione. Sono quindi PUBBLICHE per definizione: chiunque può leggerle
#  guardando il sorgente della pagina. Non metterci mai un segreto.
# ═══════════════════════════════════════════════════════════════════════════

# Indirizzo pubblico da cui il sito è realmente servito.
# Alimenta canonical, Open Graph e sitemap. Finché è diverso dal dominio
# definitivo, il sito si dichiara da sé come anteprima e resta fuori dai motori
# di ricerca (noindex + robots.txt chiuso).
VITE_SITE_URL=

# Sottocartella da cui il sito è servito. '/' per un dominio proprio.
VITE_BASE=/

# ID di misurazione Google Analytics 4 (es. G-XXXXXXXXXX).
# Identificatore pubblico, non un segreto. Se assente non viene caricato nulla;
# in ogni caso lo script parte solo dopo il consenso nel banner cookie.
VITE_GA4_ID=


# ═══════════════════════════════════════════════════════════════════════════
#  DI RUNTIME — lette solo dal server Node, mai spedite al browser.
#
#  Sono disponibili soltanto se il sito gira come applicazione Node.js.
#  Sull'hosting statico non esistono, e /api/contatti non risponde: il modulo
#  ripiega sul client di posta del visitatore.
# ═══════════════════════════════════════════════════════════════════════════

# Porta di ascolto. Sull'hosting la impone la piattaforma; in locale 3000.
PORT=3000

# Credenziali del server di posta in uscita. SEGRETE.
# Senza queste il sito funziona lo stesso: /api/contatti risponde 503 e il
# modulo apre il client di posta con la richiesta già compilata.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Mittente delle e-mail generate dal modulo.
# DEVE essere una casella del dominio, altrimenti SPF e DKIM non tornano e il
# messaggio finisce nello spam. Se vuoto, si usa SMTP_USER.
LEAD_MITTENTE=

# Destinatario delle richieste. Se vuoto, si usa l'indirizzo aziendale
# dichiarato in src/data/site.js.
LEAD_DESTINATARIO=

# Freno allo spam: quante richieste per indirizzo IP, in quanti minuti,
# e il tetto complessivo orario indipendente dall'indirizzo.
LEAD_LIMITE_INVII=5
LEAD_FINESTRA_MINUTI=10
LEAD_TETTO_ORARIO=60
