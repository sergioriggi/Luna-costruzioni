# Endpoint che riceve le richieste del modulo contatti (POST JSON).
# Può essere un form service, una funzione serverless o un CRM.
# Se non impostato, il modulo apre il client di posta con i dati compilati.
VITE_ENDPOINT_LEAD=

# ID misurazione Google Analytics 4 (es. G-XXXXXXXXXX).
# Se non impostato, nessuno script di misurazione viene caricato.
# In ogni caso lo script parte solo dopo il consenso nel banner cookie.
VITE_GA4_ID=
